database -open waves -into waves.shm -default
probe -create -shm tb_uart_top_n.dut.i_clk tb_uart_top_n.dut.i_nRst tb_uart_top_n.dut.i_rx tb_uart_top_n.dut.w_tick_16x tb_uart_top_n.dut.w_tx_start tb_uart_top_n.dut.w_tx_data tb_uart_top_n.dut.w_rx_data tb_uart_top_n.dut.w_rx_done tb_uart_top_n.dut.o_tx
