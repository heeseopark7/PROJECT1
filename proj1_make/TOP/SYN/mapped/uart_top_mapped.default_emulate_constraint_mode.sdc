set sdc_version 2.0

set_units -capacitance 1000fF
set_units -time 1000ps

# Set the current design
current_design uart_top

create_clock -name "MAIN_CLOCK" -period 0.8 -waveform {0.0 0.4} [get_ports i_clk]
set_clock_transition 0.1 [get_clocks MAIN_CLOCK]
set_load -pin_load 0.003 [get_ports o_tx]
set_load -pin_load 0.003 [get_ports o_led_ctrl]
set_clock_gating_check -setup 0.0 
set_input_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports i_nRst]
set_input_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports i_rx]
set_input_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min 0.01 [get_ports i_nRst]
set_input_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min 0.01 [get_ports i_rx]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports o_tx]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports o_led_ctrl]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min -0.01 [get_ports o_tx]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min -0.01 [get_ports o_led_ctrl]
set_operating_conditions -max_library slow_vdd1v0 -min_library library:default_emulate_libset_max/fast_vdd1v0 -min PVT_1P1V_0C -max PVT_0P9V_125C
set_driving_cell -lib_cell PADDI -library giolib045 -pin "Y" [get_ports i_nRst]
set_driving_cell -lib_cell PADDI -library giolib045 -pin "Y" [get_ports i_rx]
set_ideal_network [get_ports i_clk]
set_ideal_network [get_ports i_nRst]
set_dont_touch [get_cells pad1]
set_dont_touch [get_cells pad2]
set_dont_touch [get_cells pad3]
set_dont_touch [get_cells pad4]
set_dont_touch [get_cells pad5]
